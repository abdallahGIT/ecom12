# Required for API routes and the admin dashboard.
# Use the pooled connection string from your Neon/Vercel Postgres project.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Algerian courier provider and private API token. Never expose these in client code.
ECOTRACK_PROVIDER=navexdelivery
ECOTRACK_API_TOKEN=replace-with-private-ecotrack-token
# Optional; otherwise derived as https://<provider>.ecotrack.dz/api/v1
ECOTRACK_API_URL=
ECOTRACK_STORE_ID=

# Optional for local development; Vercel sets its own PORT.
PORT=3000
