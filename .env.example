# Required for API routes and the admin dashboard.
# Use the pooled connection string from your Neon/Vercel Postgres project.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Algerian courier provider and private API token. Never expose these in client code.
ECOTRACK_PROVIDER=navexdelivery
ECOTRACK_API_TOKEN=replace-with-private-ecotrack-token
# Optional; otherwise derived as https://<provider>.ecotrack.dz/api/v1
ECOTRACK_API_URL=
ECOTRACK_STORE_ID=

# Telegram operations notifications. Rotate the previously exposed bot token,
# then set the replacement only in the runtime environment (never in Git).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1004433355272
# Informational: @Maisonverre_bot sends order alerts to Abdallah and Maisonvert.
TELEGRAM_BOT_USERNAME=Maisonverre_bot

# Optional for local development; Vercel sets its own PORT.
PORT=3000
